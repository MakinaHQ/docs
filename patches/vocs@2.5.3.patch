+/**
+ * Plain text of a block node for indexing. `mdastToString` concatenates the
+ * children of tables and lists with no separator, so a whole table collapses
+ * into one token (e.g. `contractaddressaccessmanager0x0fce…oracleregistry0xc3…`)
+ * and no cell value is ever indexed on its own. Join rows, cells and list
+ * items with a space so each cell (e.g. a contract address) is its own term.
+ */
+function nodeToSearchText(node) {
+    if (node.type === 'table')
+        return node.children
+            .map((row) => row.children.map((cell) => mdastToString(cell)).join(' '))
+            .join(' ');
+    if (node.type === 'list' || node.type === 'listItem' || node.type === 'blockquote')
+        return node.children.map((child) => nodeToSearchText(child)).join(' ');
+    return mdastToString(node);
+}
